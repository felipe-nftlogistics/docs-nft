generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Usuario {
  id       Int     @id @default(autoincrement())
  name     String
  email    String  @unique
  password String
  isAdmin  Boolean @default(false)
  image    String?

  @@map("usuarios")
}

model Categoria {
  id          Int         @id @default(autoincrement())
  titulo      String
  slug        String      @unique
  thumb       String?
  descricao   String?
  documentos  Documento[]

  @@map("categorias")
}

model Documento {
  id          Int       @id @default(autoincrement())
  titulo      String
  slug        String
  thumb       String?
  descricao   String?
  html        String
  ativo       Boolean   @default(true)
  
  categoriaId Int
  categoria   Categoria @relation(fields: [categoriaId], references: [id], onDelete: Cascade)

  @@unique([categoriaId, slug])
  @@map("documentos")
}

model Imagem {
  id        String   @id @default(cuid())
  nome      String
  url       String   @unique
  folder    String   @default("uploads")
  size      Int      @default(0)
  width     Int?
  height    Int?
  categoria String   @default("Geral")
  profiles  String   @default("[\"Administrador\", \"Usuário Padrão\"]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("imagens")
}
